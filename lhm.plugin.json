    {
      "name": "treppenlift_stoerung",
      "title": "Treppenlift-Störung beheben",
      "description": "Use when a stairlift owner reports a problem: \"Treppenlift piept\", \"Treppenlift fährt nicht mehr\", \"Treppenlift bleibt stehen\", \"Fernbedienung Treppenlift geht nicht\", \"Treppenlift Akku\", \"Acorn Fehlercode E7\", \"Lifta Störung\", \"Treppenlift zurücksetzen\". Returns the checks in order of frequency, what not to do for safety, when to call the technician, brand notes for Lifta, Acorn, TK Home Solutions (ThyssenKrupp), Handicare, HIRO and Stannah, and the meaning of documented Acorn T700 codes. It gives no repair instructions inside the device.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "symptom": {
            "type": "string",
            "enum": [
              "piept",
              "faehrt_nicht",
              "bleibt_mit_person_stehen",
              "fernbedienung",
              "langsam_oder_akku",
              "fehlercode"
            ],
            "description": "Was passiert: piept; fährt nicht; bleibt mit Person auf der Treppe stehen; nur die Fernbedienung geht nicht; fährt langsam oder Akku hält nicht; Display zeigt einen Fehlercode."
          },
          "marke": {
            "type": "string",
            "enum": [
              "lifta",
              "acorn",
              "tk",
              "handicare",
              "hiro",
              "stannah",
              "andere"
            ],
            "description": "Optional: Hersteller. tk = TK Home Solutions, früher ThyssenKrupp."
          },
          "code": {
            "type": "string",
            "maxLength": 6,
            "description": "Optional: angezeigter Code, zum Beispiel \"E7\"."
          }
