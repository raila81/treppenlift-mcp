    {
      "name": "treppenlift_kosten_schaetzen",
      "title": "Treppenlift-Kosten schätzen",
      "description": "Use when someone in Germany asks what a stairlift or home lift costs: \"Was kostet ein Treppenlift\", \"Treppenlift Kosten mit Einbau\", \"Kurvenlift Preis\", \"Treppenlift 2 Etagen Kosten\", \"Treppenlift gebraucht Preis\", \"Plattformlift Kosten\", \"Homelift ohne Schacht Kosten\", \"Treppenraupe Preis\". Returns the market price range including installation for the lift type, stair shape and number of floors (the same calculation as the cost calculator on treppenliftvergleichsportal.de), the long-term care insurance subsidy of up to 4,180 EUR per eligible person (§ 40 (4) SGB XI) and the resulting own share, running costs, and sources with check dates. No personal data is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "liftart": {
            "type": "string",
            "enum": [
              "sitzlift",
              "stehlift",
              "plattformlift",
              "hublift",
              "homelift",
              "treppensteighilfe"
            ],
            "default": "sitzlift",
            "description": "sitzlift = Treppenlift mit Sitz (Standard); stehlift = Treppenlift zum Stehen; plattformlift = für Rollstuhl auf der Treppe; hublift = senkrecht bis ca. 1,8 m; homelift = kleiner Aufzug im Haus; treppensteighilfe = mobile Treppenraupe ohne Einbau."
          },
          "treppenform": {
            "type": "string",
            "enum": [
              "gerade",
              "kurvig",
              "aussen"
            ],
            "default": "gerade",
            "description": "Nur Sitz- und Stehlift: gerade Treppe, kurvige oder Wendeltreppe (Maßschiene), Außentreppe."
          },
          "etagen": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1,
            "description": "Nur Sitz- und Stehlift: Anzahl der Etagen, die der Lift überwindet. 3 steht für 3 oder mehr (Ergebnis ist dann eine Untergrenze)."
          },
          "zustand": {
            "type": "string",
            "enum": [
              "neu",
              "gebraucht"
            ],
            "default": "neu",
            "description": "Nur Sitzlift: neu oder gebraucht/aufbereitet."
          },
          "homelift_variante": {
            "type": "string",
            "enum": [
              "ohne_schacht",
              "mit_schacht",
              "aussen_1_geschoss",
              "aussen_2_geschosse"
            ],
            "default": "ohne_schacht",
            "description": "Nur Homelift: ohne Schacht (2 Etagen), mit Schacht oder Kabine, Außenaufzug für 1 oder 2 Geschosse."
          },
          "personen_mit_pflegegrad": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4,
            "description": "Optional: Zahl der Personen im Haushalt mit anerkanntem Pflegegrad (1 bis 5). Je Person zahlt die Pflegekasse bis 4.180 €, zusammen höchstens 16.720 €. Ohne Angabe zeigt das Ergebnis ein Beispiel mit einer Person."
          }
        },
        "additionalProperties": false
